{
  "name": "lumora-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:vercel": "npm run bundle:vercel-api && npm run build",
    "bundle:vercel-api": "node scripts/build-vercel-api.mjs",
    "test:canary-regression": "tsx backend/test/realRenderCanaryRegression.test.ts",
    "test:director": "tsx backend/test/directorV1.test.ts",
    "test:creator-experience": "tsx backend/test/createExperience.test.ts && node scripts/audit-production-copy.mjs",
    "preview": "vite preview",
    "dev:api": "tsx backend/src/index.ts",
    "seed": "tsx backend/src/scripts/seed.ts",
    "worker": "tsx backend/src/workers/generationWorker.ts",
    "check": "tsc --noEmit",
    "start:api": "node --enable-source-maps backend/dist/index.js",
    "start:worker": "node --enable-source-maps backend/dist/workers/generationWorker.js",
    "build:api": "tsc -p backend/tsconfig.json",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:android:bundle": "npm run mobile:sync && cd android && ./gradlew bundleSignedRelease"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "2.13.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.56.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "framer-motion": "^12.6.2",
    "openai": "^5.20.1",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "replicate": "^1.4.0",
    "stripe": "^18.5.0",
    "zod": "^4.1.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.27.7",
    "tsx": "^4.20.5",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
